docs/agreement.docx
docs/SOW.docx

# Python
__pycache__/
*.py[cod]
*$py.class

# Django — any SQLite database, whatever it is named, and its journal.
# Wildcarded because a server copy is easily called something else
# (db.prod.sqlite3, backup.sqlite3) and must never be committed.
*.sqlite3
*.sqlite3-journal

# Environment variables
.env
.env.local
.env.*.local

# Uploaded media — keep the folder structure but not the files.
# Every upload_to prefix needs a line here; site/ arrived with SiteSettings.
media/listings/*
!media/listings/.gitkeep
media/site/*

# Archives
*.zip

# Editor / IDE
.idea/
.vscode/
.claude/

# Prompt notes
addon_prompts_final.md
addon_prompts_final_v2.md
claude_code_prompts_1.md
